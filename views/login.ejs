<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login — Lumiskin</title>
    <link rel="stylesheet" href="/css/header.css">
    <link rel="stylesheet" href="/css/login.css">
       
</head>
<body>

<%- include('partials/header') %>

<div class="auth-layout">
    <!-- Left: Image -->
    <div class="auth-image">
        <img src="/images/skin2.jpg" alt="Skincare">
        <div class="auth-image-overlay"></div>
        <div class="auth-image-quote">
            <p>"Your skin is a reflection of your inner health."</p>
            <span>Lumiskin Philosophy</span>
        </div>
    </div>

    <!-- Right: Form -->
    <div class="auth-form-panel">
        <div class="auth-form-box">
            <p class="auth-eyebrow">Welcome back</p>
            <h1 class="auth-title">Sign In</h1>
            <p class="auth-subtitle">Enter your details to access your account.</p>

            <% if (error !== '') { %>
                <div class="error-msg"><%= error %></div>
            <% } %>

            <form action="/user/login" method="POST" onsubmit="return validateLogin()">
                <div class="field">
                    <label>Email Address</label>
                    <input type="email" name="email" placeholder="you@example.com" required>
                </div>

                <div class="field">
                    <label>Password</label>
                    <input type="password" name="password" placeholder="Your password" required>
                </div>

                <button type="submit" class="auth-btn">Sign In</button>
            </form>

            <div class="auth-divider"><span>or</span></div>

            <p class="auth-link">
                Don't have an account? <a href="/user/signup">Create one</a>
            </p>
        </div>
    </div>
</div>
<script src="/js/auth.js"></script>
</body>
</html>