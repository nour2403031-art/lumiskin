<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lumiskin Admin</title>
    <link rel="stylesheet" href="/css/admin.css">
</head>
<body>

<nav class="sidebar">
    <h2>LUMISKIN</h2>
    <p style="color:#ccc; font-size:13px; padding: 0 16px;">Welcome, <%= user %></p>
    <ul>
        <li onclick="showSection('dashboard')">Overview</li>
        <li onclick="showSection('products')">Manage Products</li>
        <li onclick="showSection('users')">Manage Users</li>
        </ul>
       <a href="/" class="return-home-card">
    <div class="return-home-content">
        <span class="home-icon">⌂</span>

        <div>
            <h3>Return To Home</h3>
        </div>
    </div>
</a>
    
    <a href="/user/logout" 
       style="color:#ccc; padding:16px; display:block; margin-top:20px;">
       Logout
    </a>
</nav>

<main class="main-content">

    <!-- DASHBOARD OVERVIEW -->
    <div id="dashboardSection" class="management-section">
        <h1>Dashboard Overview</h1>
        <div class="card-row">
            <div class="card">
                <small>TOTAL PRODUCTS</small>
                <h2 class="stat-value"><%= products.length %></h2>
            </div>
            <div class="card">
                <small>TOTAL REGISTERED USERS</small>
                <h2 class="stat-value"><%= users.length %></h2>
            </div>
        </div>
    </div>

    <!-- MANAGE PRODUCTS -->
    <div id="productsSection" class="management-section" style="display:none;">
        <h1>Manage Products</h1>

        <!-- Add Product Form -->
        <form action="/admin/add-product" method="POST" 
              style="display:flex; flex-wrap:wrap; gap:10px; margin-bottom:30px;">
            <input type="text" name="name" placeholder="Product Name" required>
            <input type="text" name="brand" placeholder="Brand" required>
            <input type="number" name="price" placeholder="Price (EGP)" required>
            <input type="text" name="category" placeholder="Category (e.g. Cleanser)">
            <input type="text" name="tag" placeholder="Tag (e.g. CLEANSE)">
            <button type="submit" class="btn-add">+ Add Product</button>
        </form>

        <!-- Products Table -->
        <table>
            <thead>
                <tr>
                    <th>NAME</th>
                    <th>BRAND</th>
                    <th>PRICE</th>
                    <th>CATEGORY</th>
                    <th>TAG</th>
                    <th>ACTIONS</th>
                </tr>
            </thead>
            <tbody>
                <% if (products.length === 0) { %>
                    <tr>
                        <td colspan="6" style="text-align:center;">
                            No products yet. Add one above!
                        </td>
                    </tr>
                <% } %>
                <% products.forEach(product => { %>
                <tr>
                    <td><%= product.name %></td>
                    <td><%= product.brand %></td>
                    <td><%= product.price %> EGP</td>
                    <td><%= product.category %></td>
                    <td><%= product.tag %></td>
                    <td>
                        <a href="/admin/edit-product/<%= product._id %>"
                           style="color:#a36c45; margin-right:10px;">Edit</a>
                        <a href="/admin/delete-product/<%= product._id %>"
                           onclick="return confirm('Are you sure you want to delete this product?')"
                           style="color:red;">Delete</a>
                    </td>
                </tr>
                <% }) %>
            </tbody>
        </table>
    </div>

    <!-- MANAGE USERS -->
    <div id="userSection" class="management-section" style="display:none;">
        <h1>Manage Users</h1>
        <table>
            <thead>
                <tr>
                    <th>NAME</th>
                    <th>EMAIL</th>
                    <th>ACTIONS</th>
                </tr>
            </thead>
            <tbody>
                <% if (users.length === 0) { %>
                    <tr>
                        <td colspan="3" style="text-align:center;">
                            No users registered yet.
                        </td>
                    </tr>
                <% } %>
                <% users.forEach(u => { %>
                <tr>
                    <td><%= u.name %></td>
                    <td><%= u.email %></td>
                    <td>
                        <a href="/admin/edit-user/<%= u._id %>"
                          style="color:#a36c45; margin-right:10px;">Edit</a>
                        <a href="/admin/delete-user/<%= u._id %>"
                           onclick="return confirm('Are you sure you want to delete this user?')"
                           style="color:red;">Delete</a>
                    </td>
                </tr>
                <% }) %>
            </tbody>
        </table>
    </div>

</main>

<script>
// Show the selected section and hide others
function showSection(name) {
    document.getElementById('dashboardSection').style.display = 'none';
    document.getElementById('productsSection').style.display = 'none';
    document.getElementById('userSection').style.display = 'none';
    document.getElementById(name + 'Section').style.display = 'block';
}
</script>

</body>
</html>