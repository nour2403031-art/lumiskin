<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>La Roche-Posay | LumiSkin</title>
    <link rel="stylesheet" href="/css/products.css">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700&display=swap" rel="stylesheet">
</head>

<body style="background-color: rgb(233, 221, 206); margin: 0; padding: 0;">

    <section class="brand-products-section">
        <div style="padding: 40px 5% 0 5%;">
            <a href="/#brand-section" style="text-decoration: none; color: #1a1a1a; font-weight: 600;">← BACK TO BRANDS</a>
        </div>

        <div class="product-grid" style="display: flex; flex-direction: row; flex-wrap: wrap; justify-content: flex-start; align-items: flex-start; padding: 40px 5%; gap: 30px; width: 100%; box-sizing: border-box;">

            <div class="product-item">
                <div class="image-wrap">
                    <span class="tag-promo">DERM APPROVED</span>
                    <img src="/images/Effaclar_Duo+M_40ml_01_La-Roche-Posay.jpg" alt="Effaclar Duo Front" class="img-primary">
                    <img src="/images/la-roche-posay-effaclar-duo-m-2.webp" alt="Effaclar Results" class="img-secondary">
                    <button class="add-to-cart-btn" onclick="addToCart('Effaclar Duo(+)', 850)">Add To Cart</button>
                </div>
                <div class="product-details">
                    <span class="brand-label">LA ROCHE-POSAY</span>
                    <h3 class="product-title">Effaclar Duo(+) Anti-Blemish Cream 40ml</h3>
                    <div class="price-row"><span class="current-price">850 EGP</span></div>
                </div>
            </div>

            <div class="product-item">
                <div class="image-wrap">
                    <span class="tag-promo">REPAIR</span>
                    <img src="/images/cica 1.webp" alt="Cicaplast Baume Front" class="img-primary">
                    <img src="/images/cica 2.webp" alt="Cicaplast Benefits" class="img-secondary">
                    <button class="add-to-cart-btn" onclick="addToCart('Cicaplast Baume B5+', 900)">Add To Cart</button>
                </div>
                <div class="product-details">
                    <span class="brand-label">LA ROCHE-POSAY</span>
                    <h3 class="product-title">Cicaplast Baume B5+ Soothing Repairing Balm 40ml</h3>
                    <div class="price-row"><span class="current-price">900 EGP</span></div>
                </div>
            </div>

            <div class="product-item">
                <div class="image-wrap">
                    <span class="tag-promo">CLEANSE</span>
                    <img src="/images/cleanser la roche 1.avif" alt="Cleanser Front" class="img-primary">
                    <img src="/images/cleanser la roche 2.avif" alt="Cleanser Back" class="img-secondary">
                    <button class="add-to-cart-btn" onclick="addToCart('Effaclar Cleanser', 710)">Add To Cart</button>
                </div>
                <div class="product-details">
                    <span class="brand-label">LA ROCHE-POSAY</span>
                    <h3 class="product-title">Effaclar Gel Moussant Purifiant 200ml</h3>
                    <div class="price-row"><span class="current-price">710 EGP</span></div>
                </div>
            </div>

            <div class="product-item">
                <div class="image-wrap">
                    <span class="tag-promo">PROTECT</span>
                    <img src="/images/sunblock1.jpg" alt="Anthelios Fluid Front" class="img-primary">
                    <img src="/images/sunblock 2.jpg" alt="Anthelios Benefits" class="img-secondary">
                    <button class="add-to-cart-btn" onclick="addToCart('Anthelios Invisible Fluid', 1150)">Add To Cart</button>
                </div>
                <div class="product-details">
                    <span class="brand-label">LA ROCHE-POSAY</span>
                    <h3 class="product-title">Anthelios UVMune 400 Invisible Fluid SPF50+</h3>
                    <div class="price-row"><span class="current-price">1,150 EGP</span></div>
                </div>
            </div>

        </div>
    </section>

    <script src="/js/product.js"></script>

</body>

</html>
