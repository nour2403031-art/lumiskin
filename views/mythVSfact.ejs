<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Lumiskin — Skin Myths Busted</title>
  <link rel="stylesheet" href="/css/mythvsfact.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  
</head>
<body>
 
  <%- include('partials/header') %>
 
  <!-- Hero -->
  <div class="myths-hero">
    <p class="myths-eyebrow">Skincare Decoded</p>
    <h1 class="myths-hero-title">Myth or <em>Truth?</em><br>Let's Fact Check.</h1>
    <p class="myths-hero-sub">Your skin has been lied to. Tap each card to reveal the real science behind the myth.</p>
    <div class="myths-score-pill">
      <i class="fas fa-star"></i>
      <span id="scoreCount">0</span> myths busted so far
    </div>
  </div>
 
  <!-- Ticker -->
  <div class="myths-ticker">
    <div class="myths-ticker-inner">
      <span>SPF is only for summer</span>
      <span>You need to feel the burn to know it's working</span>
      <span>Drinking water gives you clear skin</span>
      <span>Natural always means safe</span>
      <span>Pores can open and close</span>
      <span>You should exfoliate every day</span>
      <span>Oily skin doesn't need moisturizer</span>
      <span>Expensive skincare is always better</span>
    </div>
  </div>
 
  <!-- Progress -->
  <p class="myths-progress" id="progressText">Flip the cards to reveal the truth ↓</p>
 
  <!-- Cards grid -->
  <div class="myths-grid" id="mythsGrid"></div>
 
  <!-- CTA -->
  <div class="myths-cta">
    <h2>Ready for a routine <em>built for you?</em></h2>
    <p>Skip the guesswork. Take our skin quiz and get a personalized routine in minutes.</p>
    <a href="/quiz" class="btn-formula" style="margin:0 auto;display:inline-block;">Find my formula →</a>
  </div>
 
  <!-- Footer -->
  <footer class="footer">
    <div class="footer-top">
      <div class="footer-newsletter">
        <h2>Your Best Skin<br>Starts Here</h2>
        <p>Join our community and receive expert insights.</p>
        <div class="input-group">
          <input type="email" placeholder="Enter an email address">
          <button type="button">↗</button>
        </div>
      </div>
      <div class="footer-nav">
        <div class="nav-col">
          <h4>Discover</h4>
          <ul>
            <li><a href="/">Home</a></li>
            <li><a href="/about">About</a></li>
            <li><a href="/#brand-section">Product</a></li>
            <li><a href="/mythvsfact">Skin Myths</a></li>
          </ul>
        </div>
        <div class="nav-col">
          <h4>Contact</h4>
          <p><strong>LumiSkin Cairo</strong> Cairo, Egypt</p>
          <p><strong>LumiSkin Alexandria</strong> Alexandria, Egypt</p>
        </div>
        <div class="nav-col">
          <h4>Social Media</h4>
          <ul>
            <li><a href="#">Instagram</a></li>
            <li><a href="#">Facebook</a></li>
          </ul>
        </div>
        <div class="nav-col">
          <h4>Help & Support</h4>
          <ul>
            <li><a href="#">FAQ</a></li>
            <li><a href="#">Privacy Policy</a></li>
          </ul>
        </div>
      </div>
    </div>
    <div class="footer-brand">
      <h1>LumiSkin</h1>
    </div>
  </footer>
 
  <script src="/js/mythvsfact.js"></script>
   
</body>
</html>
