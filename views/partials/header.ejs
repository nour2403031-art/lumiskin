<!-- Unified Header CSS — loaded on every page -->
<link rel="stylesheet" href="/css/header.css">

<header>
    <div class="container">
        <nav>
            <ul class="navbuttons">
                <li><a href="/"><b>Home</b></a></li>
                <li><a href="/#brand-section"><b>Products</b></a></li>
                <li><a href="/about"><b>About</b></a></li>
                <li><a href="/skin-advisor"><b>Skin Advisor</b></a></li>
            </ul>
        </nav>

        <a href="/" class="logo">
            <div class="logotext"><i>Lumiskin</i></div>
        </a>

       <div class="nav-buttons">
    <% if (user !== '') { %>
        <% if (role === 'admin') { %>
            <a href="/admin" class="btn-secondary"><b>⚙ Admin</b></a>
        <% } %>
        <a href="/user/profile" class="btn-secondary"><b><%= user %></b></a>
        <a href="/user/logout" class="btn-secondary"><b>Logout</b></a>
    <% } else { %>
        <a href="/user/login" class="btn-secondary"><b>Account</b></a>
    <% } %>
    <a href="/user/cart" class="btn-primary"><b>Cart</b></a>
</div>
    </div>
</header>

<!-- Navbar scroll behavior — loaded on every page -->
<script src="/js/js.js"></script>