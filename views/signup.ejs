<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Account — Lumiskin</title>
    <link rel="stylesheet" href="/css/header.css">
    <link rel="stylesheet" href="/css/login.css">
</head>
   
<body>

<%- include('partials/header') %>

<div class="auth-layout">
    <!-- Left: Image -->
    <div class="auth-image">
        <img src="/images/skin2.jpg" alt="Skincare">
        <div class="auth-image-overlay"></div>
        <div class="auth-image-quote">
            <p>"Invest in your skin. It's going to represent you for a very long time."</p>
            <span>Lumiskin Philosophy</span>
        </div>
    </div>

    <!-- Right: Form -->
    <div class="auth-form-panel">
        <div class="auth-form-box">
            <p class="auth-eyebrow">Join Lumiskin</p>
            <h1 class="auth-title">Create Account</h1>
            <p class="auth-subtitle">Start your personalized skincare journey today.</p>

            <% if (error !== '') { %>
                <div class="error-msg"><%= error %></div>
            <% } %>

            <form action="/user/signup" method="POST" onsubmit="return validateLogin()">
                <div class="field-row">
                    <div class="field">
                        <label>First Name</label>
                        <input type="text" name="fname" placeholder="Nour" required>
                    </div>
                    <div class="field">
                        <label>Last Name</label>
                        <input type="text" name="lname" placeholder="Ahmed" required>
                    </div>
                </div>

                <div class="field">
                    <label>Email Address</label>
                    <input type="email" name="email" placeholder="you@example.com" required>
                </div>

                <div class="field">
                    <label>Password</label>
                    <input type="password" name="password" placeholder="Min 8 characters" required>
                </div>

                <div class="field">
                    <label>Confirm Password</label>
                    <input type="password" name="confirmPassword" placeholder="Repeat your password" required>
                </div>

                <button type="submit" class="auth-btn">Create Account</button>
            </form>

            <div class="auth-divider"><span>or</span></div>

            <p class="auth-link">
                Already have an account? <a href="/user/login">Sign in</a>
            </p>

            <p class="terms-note">
                By creating an account, you agree to our privacy policy and terms of service.
            </p>
        </div>
    </div>
</div>
<script src="/js/auth.js"></script>
</body>
</html>