<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CeraVe | LumiSkin</title>
    <link rel="stylesheet" href="/css/products.css">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700&display=swap" rel="stylesheet">
</head>

<body style="background-color: rgb(233, 221, 206); margin: 0; padding: 0;">

    <section class="brand-products-section">
        <div style="padding: 40px 5% 0 5%;">
            <a href="/#brand-section" style="text-decoration: none; color: #1a1a1a; font-weight: 600;">← BACK TO BRANDS</a>
        </div>

        <div class="product-grid" style="display: flex; flex-direction: row; flex-wrap: wrap; justify-content: center; align-items: flex-start; padding: 40px 5%; gap: 30px; width: 100%; box-sizing: border-box;">

            <div class="product-item">
                <div class="image-wrap">
                    <span class="tag-promo">DERM APPROVED</span>
                    <img src="/images/CeraVe-Moisturizing-Lotion.avif" alt="CeraVe Moisturizing Lotion" class="img-primary">
                    <img src="/images/cerave second moist.webp" alt="CeraVe Benefits" class="img-secondary">
                    <button class="add-to-cart-btn" onclick="addToCart('CeraVe Daily Moisturizing Lotion', 650)">Add To Cart</button>
                </div>
                <div class="product-details">
                    <span class="brand-label">CERAVE</span>
                    <h3 class="product-title">Daily Moisturizing Lotion for Normal to Dry Skin 473ml</h3>
                    <div class="price-row"><span class="current-price">650 EGP</span></div>
                </div>
            </div>

            <div class="product-item">
                <div class="image-wrap">
                    <span class="tag-promo">CLEANSE</span>
                    <img src="/images/foaming-cleanser-236ml-1 cerave.jpg" alt="CeraVe Foaming Cleanser" class="img-primary">
                    <img src="/images/cerave cleanse 2.avif" alt="CeraVe Cleanser Texture" class="img-secondary">
                    <button class="add-to-cart-btn" onclick="addToCart('CeraVe Foaming Cleanser', 550)">Add To Cart</button>
                </div>
                <div class="product-details">
                    <span class="brand-label">CERAVE</span>
                    <h3 class="product-title">Foaming Facial Cleanser for Normal to Oily Skin 236ml</h3>
                    <div class="price-row"><span class="current-price">550 EGP</span></div>
                </div>
            </div>

            <div class="product-item">
                <div class="image-wrap">
                    <span class="tag-promo">CLEANSE</span>
                    <img src="/images/hydrating-cleanser-236ml-first cerave.jpg" alt="Cleanser Front" class="img-primary">
                    <img src="/images/cerave cleanser dry skin 2.avif" alt="Cleanser Back" class="img-secondary">
                    <button class="add-to-cart-btn" onclick="addToCart('CeraVe Hydrating Cleanser', 580)">Add To Cart</button>
                </div>
                <div class="product-details">
                    <span class="brand-label">CERAVE</span>
                    <h3 class="product-title">Hydrating Facial Cleanser for Normal to Dry Skin 236ml</h3>
                    <div class="price-row"><span class="current-price">580 EGP</span></div>
                </div>
            </div>

            <div class="product-item">
                <div class="image-wrap">
                    <span class="tag-promo">PROTECT</span>
                    <img src="/images/sunblock cera 1.webp" alt="CeraVe AM Lotion" class="img-primary">
                    <img src="/images/sunblock cera 2.avif" alt="CeraVe SPF Benefits" class="img-secondary">
                    <button class="add-to-cart-btn" onclick="addToCart('CeraVe AM Moisturising Lotion', 1150)">Add To Cart</button>
                </div>
                <div class="product-details">
                    <span class="brand-label">CERAVE</span>
                    <h3 class="product-title">AM Facial Moisturising Lotion with SPF 50 52ml</h3>
                    <div class="price-row"><span class="current-price">1,150 EGP</span></div>
                </div>
            </div>

        </div>
    </section>

    <script src="/js/product.js"></script>
</body>
</html>
